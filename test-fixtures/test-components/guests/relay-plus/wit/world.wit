package test:relay@0.2.0;

/// The same contract as `test:relay/relay@0.1.0`, implemented differently:
/// adds one more (`in + add + 1`).
world relay {
    export node: interface {
        record inputs {
            in: u32,
            add: option<u32>,
        }
        record outputs {
            out: u32,
        }
        run: async func(inputs: inputs) -> outputs;
    }
}

package test:tensor-source@0.1.0;

/// A `[height, width, 4]` `uint8` tensor (RGBA rows): a gradient shifted by
/// `seed`, `width` x `height` pixels (64 x 48 when absent).
world tensor-source {
    import test:data/tensor@0.1.0;

    export node: interface {
        use test:data/tensor@0.1.0.{tensor};
        record inputs {
            width: option<u32>,
            height: option<u32>,
            seed: option<u32>,
        }
        record outputs {
            tensor: tensor,
        }
        run: async func(inputs: inputs) -> outputs;
    }
}

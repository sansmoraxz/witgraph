package test:configurable@0.1.0;

/// Multiplies a rate by a gain; absent inputs default to 1 and 1.0.
world configurable {
    export node: interface {
        record inputs {
            rate: option<u32>,
            gain: option<f64>,
        }
        record outputs {
            %result: f64,
        }
        run: async func(inputs: inputs) -> outputs;
    }
}

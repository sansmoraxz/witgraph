package test:frame-grayscale@0.1.0;

/// Turns every frame of its input stream gray (each pixel's red, green and
/// blue set to its luma) as the frames arrive. Stops once its reader is
/// dropped.
world frame-grayscale {
    export node: interface {
        /// An image: `width` x `height` pixels, row by row, four bytes
        /// (red, green, blue, alpha) each.
        record frame {
            width: u32,
            height: u32,
            pixels: list<u8>,
        }
        record inputs {
            frames: stream<frame>,
        }
        record outputs {
            frames: stream<frame>,
        }
        run: async func(inputs: inputs) -> outputs;
    }
}

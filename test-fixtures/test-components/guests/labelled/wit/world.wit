package test:labelled@0.1.0;

/// Reads one key from each of two stores: the same interface imported under
/// two labels, which a host may back differently.
world labelled {
    import primary: wasi:keyvalue/store@0.2.0-draft2;
    import backup: wasi:keyvalue/store@0.2.0-draft2;

    export node: interface {
        record inputs {
            key: option<string>,
        }
        record outputs {
            primary: string,
            backup: string,
        }
        run: async func(inputs: inputs) -> outputs;
    }
}

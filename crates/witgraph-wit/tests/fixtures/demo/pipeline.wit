package demo:graph@0.1.0;

/// Smooths a stream of readings.
world filter {
    import demo:caps/log@0.1.0;

    export node: interface {
        record reading {
            value: f64,
            timestamp: u64,
        }

        record inputs {
            raw: stream<reading>,
        }

        record outputs {
            filtered: stream<reading>,
            /// Resolves with a summary when the input stream closes.
            done: future<string>,
        }

        run: async func(inputs: inputs) -> outputs;
    }
}

/// Renders the filtered stream.
world display {
    export node: interface {
        record reading {
            value: f64,
            timestamp: u64,
        }

        record inputs {
            view: stream<reading>,
            done: future<string>,
        }

        run: async func(inputs: inputs);
    }
}

/// Sums an entire stream of readings. The node collects the stream itself
/// (reading it to end-of-stream) and resolves `summary` once it closes.
world collector {
    export node: interface {
        record reading {
            value: f64,
            timestamp: u64,
        }

        record inputs {
            samples: stream<reading>,
            /// Scale factor, read when `run` starts.
            scale: option<f64>,
        }

        record outputs {
            /// The scaled total, resolved when `samples` closes.
            summary: future<f64>,
        }

        run: async func(inputs: inputs) -> outputs;
    }
}

/// Reacts to threshold crossings.
world alarm {
    export node: interface {
        record inputs {
            trigger: stream<f64>,
        }

        run: async func(inputs: inputs);
    }
}

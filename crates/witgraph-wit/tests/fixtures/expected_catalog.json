{
  "schema_version": 6,
  "components": [
    {
      "id": "demo/demo:graph/accumulator@0.1.0",
      "component": "demo",
      "world": "demo:graph/accumulator@0.1.0",
      "package": "demo:graph@0.1.0",
      "docs": "Integrates deltas into a running total carried across iterations.",
      "inputs": [
        {
          "name": "delta",
          "kind": "value",
          "type_display": "f64",
          "optional": true
        },
        {
          "name": "state-in",
          "kind": "value",
          "type_display": "f64",
          "optional": true,
          "docs": "Previous iteration's total, delivered over a feedback edge."
        }
      ],
      "outputs": [
        {
          "name": "state-out",
          "kind": "value",
          "type_display": "f64",
          "optional": false
        }
      ],
      "capabilities": []
    },
    {
      "id": "demo/demo:graph/alarm@0.1.0",
      "component": "demo",
      "world": "demo:graph/alarm@0.1.0",
      "package": "demo:graph@0.1.0",
      "docs": "Reacts to threshold crossings.",
      "inputs": [
        {
          "name": "trigger",
          "kind": "stream",
          "type_display": "f64",
          "optional": false
        }
      ],
      "outputs": [],
      "capabilities": []
    },
    {
      "id": "demo/demo:graph/collector@0.1.0",
      "component": "demo",
      "world": "demo:graph/collector@0.1.0",
      "package": "demo:graph@0.1.0",
      "docs": "Sums an entire stream of readings. The node collects the stream itself\n(reading it to end-of-stream) and resolves `summary` once it closes.",
      "inputs": [
        {
          "name": "samples",
          "kind": "stream",
          "type_display": "record { value: f64, timestamp: u64 }",
          "optional": false
        },
        {
          "name": "scale",
          "kind": "value",
          "type_display": "f64",
          "optional": true,
          "docs": "Scale factor, read when `run` starts."
        }
      ],
      "outputs": [
        {
          "name": "summary",
          "kind": "future",
          "type_display": "f64",
          "optional": false,
          "docs": "The scaled total, resolved when `samples` closes."
        }
      ],
      "capabilities": [],
      "types": [
        {
          "name": "reading",
          "type_display": "record { value: f64, timestamp: u64 }"
        }
      ]
    },
    {
      "id": "demo/demo:graph/display@0.1.0",
      "component": "demo",
      "world": "demo:graph/display@0.1.0",
      "package": "demo:graph@0.1.0",
      "docs": "Renders the filtered stream.",
      "inputs": [
        {
          "name": "view",
          "kind": "stream",
          "type_display": "record { value: f64, timestamp: u64 }",
          "optional": false
        },
        {
          "name": "done",
          "kind": "future",
          "type_display": "string",
          "optional": false
        }
      ],
      "outputs": [],
      "capabilities": [],
      "types": [
        {
          "name": "reading",
          "type_display": "record { value: f64, timestamp: u64 }"
        }
      ]
    },
    {
      "id": "demo/demo:graph/filter@0.1.0",
      "component": "demo",
      "world": "demo:graph/filter@0.1.0",
      "package": "demo:graph@0.1.0",
      "docs": "Smooths a stream of readings.",
      "inputs": [
        {
          "name": "raw",
          "kind": "stream",
          "type_display": "record { value: f64, timestamp: u64 }",
          "optional": false
        }
      ],
      "outputs": [
        {
          "name": "filtered",
          "kind": "stream",
          "type_display": "record { value: f64, timestamp: u64 }",
          "optional": false
        },
        {
          "name": "done",
          "kind": "future",
          "type_display": "string",
          "optional": false,
          "docs": "Resolves with a summary when the input stream closes."
        }
      ],
      "capabilities": [
        {
          "name": "wasi:logging/logging@0.1.0-draft"
        }
      ],
      "types": [
        {
          "name": "reading",
          "type_display": "record { value: f64, timestamp: u64 }"
        }
      ]
    },
    {
      "id": "demo/demo:graph/sensor@0.1.0",
      "component": "demo",
      "world": "demo:graph/sensor@0.1.0",
      "package": "demo:graph@0.1.0",
      "docs": "Periodically samples a sensor and publishes readings.",
      "inputs": [
        {
          "name": "sample-rate",
          "kind": "value",
          "type_display": "u32",
          "optional": true,
          "docs": "Samples per second; the component picks a default when absent."
        }
      ],
      "outputs": [
        {
          "name": "latest",
          "kind": "value",
          "type_display": "record { value: f64, timestamp: u64 }",
          "optional": false,
          "docs": "The first reading, available as soon as `run` returns."
        },
        {
          "name": "samples",
          "kind": "stream",
          "type_display": "record { value: f64, timestamp: u64 }",
          "optional": false,
          "docs": "Ordered stream of all readings."
        },
        {
          "name": "threshold-crossed",
          "kind": "stream",
          "type_display": "f64",
          "optional": false,
          "docs": "One item each time a reading crosses the configured threshold."
        }
      ],
      "capabilities": [
        {
          "name": "wasi:clocks/monotonic-clock@0.3.2"
        }
      ],
      "types": [
        {
          "name": "reading",
          "type_display": "record { value: f64, timestamp: u64 }",
          "docs": "A single timestamped sensor reading."
        }
      ]
    }
  ]
}

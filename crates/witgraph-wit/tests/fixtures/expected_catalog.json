    {
      "id": "demo:graph/sensor@0.1.0",
      "package": "demo:graph@0.1.0",
      "world": "sensor",
      "content_hash": "98826b5bd214a9589d1c757ee520c9d3e9e90aad7dca1c9c3519a8690dbd89f9",
      "docs": "Periodically samples a sensor and publishes readings.",
      "inputs": [
        {
          "name": "sample-rate",
          "kind": "value",
          "type_display": "u32",
          "optional": true,
          "docs": "Samples per second; the component picks a default when absent."
        }
      ],
      "outputs": [
        {
          "name": "latest",
          "kind": "value",
          "type_display": "record { value: f64, timestamp: u64 }",
          "optional": false,
          "docs": "The first reading, available as soon as `run` returns."
        },
        {
          "name": "samples",
          "kind": "stream",
          "type_display": "record { value: f64, timestamp: u64 }",
          "optional": false,
          "docs": "Ordered stream of all readings."
        },
        {
          "name": "threshold-crossed",
          "kind": "stream",
          "type_display": "f64",
          "optional": false,
          "docs": "One item each time a reading crosses the configured threshold."
        }
      ],
      "run": "async",
      "capabilities": [
        "demo:caps/clock@0.1.0"
      ],
      "types": [
        {
          "name": "reading",
          "type_display": "record { value: f64, timestamp: u64 }",
          "docs": "A single timestamped sensor reading."
        }

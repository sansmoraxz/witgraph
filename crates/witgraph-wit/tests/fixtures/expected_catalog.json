          "optional": false
        }
      ],
      "outputs": [],
      "run": "async",
      "capabilities": [],
      "types": [
        {
          "name": "reading",
          "type_display": "record { value: f64, timestamp: u64 }"
        }
      ]
    },
    {
      "id": "demo:graph/filter@0.1.0",
      "package": "demo:graph@0.1.0",
      "world": "filter",
      "content_hash": "78aa34fac1712f23fb902d3e01e656fce9c42b0dcde392beab50d84d310ccb76",

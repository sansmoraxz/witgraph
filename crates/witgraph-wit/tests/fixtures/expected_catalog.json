      "world": "collector",
      "content_hash": "919424732c55fe9f533cd6e0dc5bf179578c2b87b5c5769ec99842cda206e088",
      "docs": "Sums an entire stream of readings. The node collects the stream itself\n(reading it to end-of-stream) and resolves `summary` once it closes.",
      "inputs": [
        {
          "name": "samples",
          "kind": "stream",
          "type_display": "record { value: f64, timestamp: u64 }",
          "optional": false
        },
        {
          "name": "scale",
          "kind": "value",
          "type_display": "f64",
          "optional": true,
          "docs": "Scale factor, read when `run` starts."
        }
      ],
      "outputs": [
        {
          "name": "summary",
          "kind": "future",
          "type_display": "f64",
          "optional": false,
          "docs": "The scaled total, resolved when `samples` closes."
        }
      ],
      "run": "async",
      "capabilities": [],
      "types": [
        {
          "name": "reading",
          "type_display": "record { value: f64, timestamp: u64 }"
        }
      ]
    },
